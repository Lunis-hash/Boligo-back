# Variables publiques lues par Expo au build (préfixe EXPO_PUBLIC_). Aucune clé secrète ici.
# L'app ne parle qu'au backend NestJS BOLIGO : ni Supabase ni Daily.co ne sont appelés depuis l'app.
EXPO_PUBLIC_API_URL=https://boligo-back.onrender.com/api
# Clé *publiable* Stripe du compte BOLIGO (test : pk_test_…, production : pk_live_… via EAS env).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
