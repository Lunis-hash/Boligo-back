# Variables publiques lues par Expo au moment du build (préfixe EXPO_PUBLIC_).
# L'application ne parle qu'au backend NestJS (Boligo-back) : elle n'utilise
# PAS Supabase directement, aucune clé Supabase n'est donc nécessaire ici.

# URL de l'API, préfixe /api inclus (production Render).
EXPO_PUBLIC_API_URL=https://boligo-back.onrender.com/api

# Clé *publiable* Stripe (test en développement, live en production via EAS :
#   eas env:create --name EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY --environment production).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
