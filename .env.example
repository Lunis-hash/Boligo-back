DATABASE_URL="postgresql://user:pass@localhost:5432/boligo?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3000
GROQ_API_KEY=""
# OpenRouter API Key — Orchestrateur IA principal pour les 5 Intelligences Harmonie
OPENROUTER_API_KEY=""
# Sondeur : IA par défaut (ai). Mettre "bank" pour questions fixes uniquement.
HARMONY_QUESTIONS_SOURCE=ai
# Daily.co — appels vidéo 1-to-1 (free tier)
DAILY_API_KEY=""
# true = autoriser l’appel vidéo dès la phase chat (tests). false = prod stricte.
VIDEO_TEST_UNLOCK="true"
# Tableau de bord : adresse du premier administrateur (compte BOLIGO déjà vérifié).
# N'agit que tant qu'aucun administrateur n'existe. Voir docs/PROGRAMME_PARTENAIRES.md.
ADMIN_BOOTSTRAP_EMAIL=
# Programme partenaires : adresse qui reçoit les nouvelles candidatures (défaut contact@boligo.fr)
PARTNERS_NOTIFY_EMAIL=
# Adresse publique du site, utilisée dans les liens de l'Espace partenaire (défaut https://boligo-web.onrender.com)
PUBLIC_WEB_URL=
