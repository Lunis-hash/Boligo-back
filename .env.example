DATABASE_URL="postgresql://user:pass@localhost:5432/boligo?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3000
GROQ_API_KEY=""
# OpenRouter API Key — Orchestrateur IA principal pour les 5 Intelligences Harmonie
OPENROUTER_API_KEY=""
# Sondeur : IA par défaut (ai). Mettre "bank" pour questions fixes uniquement.
HARMONY_QUESTIONS_SOURCE=ai
# Daily.co — appels vidéo 1-to-1 (free tier)
DAILY_API_KEY=""
# true = autoriser l’appel vidéo dès la phase chat (tests). false = prod stricte.
VIDEO_TEST_UNLOCK="true"
# Tableau de bord : adresse du premier administrateur (compte BOLIGO déjà vérifié).
# N'agit que tant qu'aucun administrateur n'existe. Voir docs/PROGRAMME_PARTENAIRES.md.
ADMIN_BOOTSTRAP_EMAIL=
# Programme partenaires : adresse qui reçoit les nouvelles candidatures (défaut contact@boligo.fr)
PARTNERS_NOTIFY_EMAIL=
# Adresse publique du site, utilisée dans les liens de l'Espace partenaire (défaut https://boligo-web.onrender.com)
PUBLIC_WEB_URL=
# IA : plafond de dépense mensuel en euros, hors parcours payés (défaut 10 ; 0 coupe ces usages). Voir docs/IA_COUTS.md.
AI_MONTHLY_BUDGET_EUR=10
# Portrait des membres rédigé sans IA par défaut ; « ai » pour la rédaction par l'IA (dans le plafond).
AI_PROFILE_MODE=
# Suivi IA des parcours payés (Sondeur, lectures, bilan) : budget par parcours, hors plafond mensuel ; 0 coupe ce suivi.
AI_JOURNEY_BUDGET_EUR=1
# Modèle Groq des parcours payés (vide : openai/gpt-oss-120b puis llama-3.3-70b-versatile).
GROQ_QUALITY_MODEL=
# Relecteur indépendant des questions du Sondeur (vide : llama-3.3-70b-versatile puis openai/gpt-oss-120b).
GROQ_CRITIC_MODEL=
# Vérification automatique des sociétés britanniques (clé gratuite Companies House), facultatif.
COMPANIES_HOUSE_API_KEY=
