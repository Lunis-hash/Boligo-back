# ═════════════════════════════════════════════════════════════════════════════
# BOLIGO — variables d'environnement de l'API (NestJS + Prisma)
# ═════════════════════════════════════════════════════════════════════════════
# Copier en .env (jamais versionné) puis renseigner. Toutes les valeurs ci-dessous
# sont des EXEMPLES non secrets. Les secrets réels se saisissent uniquement dans
# l'hébergeur (Render → Environment, ou le .env du serveur), jamais dans le dépôt.
#
# Légende : [OBLIGATOIRE] l'API ne fonctionne pas sans ; [PROD] fortement
# recommandé en production ; [OPTIONNEL] a une valeur par défaut sûre.
# « (nouveau) » : variable absente d'origin/main, à ajouter lors du déploiement.
# Inventaire : docs/MIGRATION_SERVEUR.md §3.

# ─── Serveur ──────────────────────────────────────────────────────────────────
# [OPTIONNEL] Port d'écoute HTTP (défaut 3000 ; Render l'impose lui-même).
PORT=3000
# [PROD] « production » active les protections (webhooks Stripe signés, e-mails
# masqués dans les journaux…). « test » coupe les minuteries (jest).
NODE_ENV=production
# [OPTIONNEL] Version affichée par GET /api/health (défaut : version de
# package.json). Ex. empreinte du commit injectée au build Docker. (nouveau)
APP_VERSION=

# ─── Base de données (Postgres) ───────────────────────────────────────────────
# [OBLIGATOIRE] Connexion utilisée par l'application (pooler accepté).
DATABASE_URL="postgresql://boligo:motdepasse@localhost:5432/boligo?schema=public"
# [OBLIGATOIRE pour la CLI Prisma] Connexion directe (sans pooler) utilisée par
# `prisma db push` ; référencée par prisma/schema.prisma (directUrl).
DIRECT_URL="postgresql://boligo:motdepasse@localhost:5432/boligo?schema=public"
# [OPTIONNEL — à laisser VIDE] Transfert ponctuel de la base au démarrage vers
# cette URL (src/maintenance/db-transfer.ts). À ne définir que pour une copie
# planifiée, puis à retirer aussitôt.
DB_TRANSFER_TARGET_URL=

# ─── Authentification ────────────────────────────────────────────────────────
# [OBLIGATOIRE] Secret de signature des jetons JWT (long, aléatoire). Le changer
# déconnecte tous les membres et administrateurs.
JWT_SECRET="remplacer-par-une-longue-valeur-aleatoire"
# [OPTIONNEL] Durée de validité des jetons (défaut 7d).
JWT_EXPIRES_IN="7d"
# [OPTIONNEL — JAMAIS en production] true : code OTP de test accepté / renvoyé.
OTP_DEBUG=false
# [OPTIONNEL] Connexion Google : identifiants OAuth acceptés, séparés par des virgules.
GOOGLE_CLIENT_IDS=
# [OPTIONNEL] Connexion Facebook (les deux ou aucun).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ─── Adresses publiques et CORS ──────────────────────────────────────────────
# [PROD] Adresse de l'application web : liens des e-mails, retour de paiement
# Stripe (défaut https://boligo-web.onrender.com).
WEB_APP_URL=https://boligo-web.onrender.com
# [OPTIONNEL] Adresse du site dans les liens de l'Espace partenaire (même défaut).
PUBLIC_WEB_URL=
# [OPTIONNEL] Adresse annoncée à OpenRouter (en-tête HTTP-Referer ; même défaut).
APP_URL=
# [PROD] Origines supplémentaires autorisées pour /api/admin (séparées par des
# virgules), en plus de https://boligo-admin.onrender.com et http://localhost:3001.
# À compléter avec l'adresse du tableau de bord sur le nouveau serveur.
ADMIN_ALLOWED_ORIGINS=
# [OPTIONNEL] Adresse du premier administrateur (compte déjà vérifié) ; n'agit que
# tant qu'aucun administrateur n'existe. Voir docs/PROGRAMME_PARTENAIRES.md.
ADMIN_BOOTSTRAP_EMAIL=

# ─── E-mails (un seul mode actif ; aucun → simulation, rien n'est envoyé) ────
# Priorité : Resend, puis SendGrid, puis Brevo, puis SMTP. Voir docs/EMAIL_ZOHO_BOLIGO.md.
RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=
# Ancien nom de BREVO_API_KEY, encore lu.
SENDINBLUE_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# [OPTIONNEL] Expéditeur (défaut « BOLIGO <no-reply@boligo.fr> »).
EMAIL_FROM="BOLIGO <no-reply@boligo.fr>"
EMAIL_REPLY_TO=
# [OPTIONNEL] Adresse de contact affichée dans les e-mails (défaut contact@boligo.fr).
CONTACT_EMAIL=
# [OPTIONNEL] Destinataire des candidatures partenaires (défaut contact@boligo.fr).
PARTNERS_NOTIFY_EMAIL=
# [PROD] Signalements urgents du Sondeur (détresse, mineur, menace, violence
# exercée) : adresses de modération, séparées par des virgules. L'e-mail ne
# contient ni nom ni réponse.
SAFETY_ALERT_EMAILS=

# ─── IA : clés et budgets (docs/IA_COUTS.md) ─────────────────────────────────
# [OPTIONNEL] OpenRouter (payant) : Claude rédige, GPT relit pour les parcours payés.
OPENROUTER_API_KEY=
# [OPTIONNEL — essais / banc uniquement] « proxy » : aucune clé envoyée, un proxy
# sortant ajoute lui-même l'authentification. Exige NODE_USE_ENV_PROXY=1 et
# HTTPS_PROXY. Ne pas définir sur Render. (nouveau)
OPENROUTER_AUTH=
# [OPTIONNEL — essais locaux uniquement] Variable de Node.js (22.21+ / 24+) : le fetch
# intégré emprunte HTTPS_PROXY. Va avec OPENROUTER_AUTH=proxy. (nouveau)
NODE_USE_ENV_PROXY=
# [OPTIONNEL — essais locaux uniquement] Autre adresse d'API (faux OpenRouter local).
OPENROUTER_BASE_URL=
# [OPTIONNEL] Modèles OpenRouter par rôle (vides : choix automatique, limité aux
# modèles qualifiés de config/sondeur-models.json pour le Sondeur).
OPENROUTER_MODEL=
OPENROUTER_QUALITY_MODEL=
OPENROUTER_CRITIC_MODEL=
OPENROUTER_ESCALATION_MODEL=
# [OPTIONNEL] Prix plafond en $ par million de jetons (défauts 5 / 25).
OPENROUTER_MAX_PRICE_PROMPT=
OPENROUTER_MAX_PRICE_COMPLETION=
# [OPTIONNEL] true : n'utiliser que des fournisseurs « zéro conservation » (ZDR).
OPENROUTER_ZDR=
# [OPTIONNEL] Groq (secours / usages gratuits).
GROQ_API_KEY=
# [OPTIONNEL] Modèles Groq, un ou plusieurs séparés par des virgules (vides : choix automatique).
GROQ_MODEL=
GROQ_QUALITY_MODEL=
GROQ_CRITIC_MODEL=
# [OPTIONNEL] Plafond mensuel hors parcours payés, en euros (défaut 10 ; 0 coupe ces usages).
AI_MONTHLY_BUDGET_EUR=10
# [OPTIONNEL] Budget IA par parcours payé, en euros (défaut 3 ; 0 coupe ce suivi
# ET la relecture de sécurité par l'IA).
AI_JOURNEY_BUDGET_EUR=3
# [OPTIONNEL] Plafond mensuel de tout le suivi IA des parcours payés (défaut 100 ; 0 coupe).
AI_JOURNEY_MONTHLY_CAP_EUR=100
# [OPTIONNEL] Portrait des membres sans IA par défaut ; « ai » pour la rédaction par l'IA.
AI_PROFILE_MODE=

# ─── Sondeur et entretien ────────────────────────────────────────────────────
# [OPTIONNEL] IA par défaut (« ai ») ; « bank » : questions fixes uniquement.
HARMONY_QUESTIONS_SOURCE=ai
# [OPTIONNEL] Plafond de jetons d'une génération du Sondeur (défaut 4500). (nouveau)
SONDEUR_MAX_TOKENS=
# [OPTIONNEL] Chemin du fichier de qualification des modèles (défaut :
# <racine>/config/sondeur-models.json, résolu depuis dist/ai/). Ne le définir
# que si le fichier est ailleurs (ex. volume monté). (nouveau)
SONDEUR_MODELS_FILE=
# [OPTIONNEL — recette locale] Écart entre deux essais de lecture IA, en ms
# (défaut 600000 = 10 min ; la règle des 3 essais ne change pas). Ne pas
# définir en production. (nouveau)
INSIGHTS_RETRY_AFTER_MS=
# [OPTIONNEL] Version de l'entretien des NOUVEAUX membres : « 8.2 » pour tous,
# sinon 7.1 (défaut). Un entretien commencé garde sa version. (nouveau)
INTERVIEW_VERSION=
# [OPTIONNEL] Activation progressive de la V8.2 : pourcentage 0–100 (ignoré si
# INTERVIEW_VERSION=8.2). (nouveau)
INTERVIEW_V82_PERCENT=

# ─── Parcours, vidéo, modération ─────────────────────────────────────────────
# [PROD] Daily.co — appels vidéo 1-to-1 (sans clé : mode dégradé).
DAILY_API_KEY=
# [OPTIONNEL] true : appel vidéo autorisé dès la phase chat (tests). false en production.
VIDEO_TEST_UNLOCK=false
# [OPTIONNEL] Moniteur anti-ghosting : observe (défaut) | on | off. Voir docs/ANTI_GHOSTING.md.
GHOSTING_MONITOR=observe
# [OPTIONNEL] Vérification des sociétés britanniques (clé gratuite Companies House).
COMPANIES_HOUSE_API_KEY=

# ─── Paiement et facturation (Stripe BOLIGO, jamais un autre compte) ─────────
# Voir docs/FACTURATION_TVA.md et docs/STRIPE_PASSAGE_EN_LIVE.md.
# [PROD] Clé secrète Stripe (sk_test_… / sk_live_…). Sans elle : paiements indisponibles.
STRIPE_SECRET_KEY=
# [PROD] Secret du point de terminaison webhook (whsec_…) pour POST /api/payment/webhook.
# Il CHANGE si on crée un nouveau point de terminaison (nouvelle adresse).
STRIPE_WEBHOOK_SECRET=
# [OPTIONNEL] Clé publiable renvoyée à l'app par l'API (pk_test_… / pk_live_…).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Registre des paiements, factures et avoirs en base (après la migration
# prisma/sql/2026-10-07_facturation.sql). Tout est désactivé par défaut.
BILLING_ENABLED=false
# TVA calculée par Stripe Tax.
BILLING_STRIPE_TAX=false
BILLING_TAX_CODE=txcd_10000000
# Adresse de facturation complète demandée sur la feuille de paiement.
BILLING_ADDRESS_REQUIRED=false
# Paiement refusé sans demande de commencement avant la fin du délai de rétractation.
BILLING_EARLY_START_CONSENT_REQUIRED=false
# Franchise en base de TVA (art. 293 B du CGI) : à confirmer avec l'expert-comptable.
BILLING_VAT_FRANCHISE=false
# Identité du vendeur sur les factures et les reçus.
BILLING_SELLER_NAME=BOLIGO
BILLING_SELLER_LEGAL_FORM=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_SIREN=
BILLING_SELLER_VAT_NUMBER=
BILLING_MEDIATOR=
# Équipe prévenue des litiges, rétractations et factures en échec (séparées par des virgules).
BILLING_ALERT_EMAILS=

# ═════════════════════════════════════════════════════════════════════════════
# docker-compose.yml uniquement (lues par Compose, pas par l'API)
# ═════════════════════════════════════════════════════════════════════════════
# [OBLIGATOIRE avec Compose] Mot de passe du Postgres du conteneur « db ».
POSTGRES_PASSWORD=
# Image Postgres (défaut postgres:16 ; postgres:17 recommandé pour restaurer
# un dump de la base Supabase actuelle, qui est en PostgreSQL 17).
POSTGRES_IMAGE=postgres:16
POSTGRES_USER=boligo
POSTGRES_DB=boligo
# Base externe au lieu du conteneur « db » (sinon calculées automatiquement).
API_DATABASE_URL=
API_DIRECT_URL=
# Ports publiés sur l'hôte.
API_PORT=3000
WEB_PORT=8080
ADMIN_PORT=8081
DB_PORT=5432
# Adresse publique de l'API vue par le navigateur, figée dans le web et l'admin au build.
PUBLIC_API_URL=http://localhost:3000/api
# Fichier d'environnement de l'API (défaut .env).
API_ENV_FILE=

# ═════════════════════════════════════════════════════════════════════════════
# Applications front (lues AU BUILD, publiques : jamais de secret)
# ═════════════════════════════════════════════════════════════════════════════
# mobile-steve/ (Expo) — voir mobile-steve/.env.example :
#   EXPO_PUBLIC_API_URL=https://boligo-back.onrender.com/api   [OBLIGATOIRE en web]
#   EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_…                [OPTIONNEL]
# admin/ (Next.js, export statique) :
#   NEXT_PUBLIC_API_URL=https://boligo-back.onrender.com/api   [OBLIGATOIRE]
#   NEXT_PUBLIC_WEB_URL=https://boligo-web.onrender.com        [OPTIONNEL]

# ═════════════════════════════════════════════════════════════════════════════
# Banc d'essai des modèles (scripts/sondeur-benchmark.ts, gate-eval…) — NE PAS
# définir sur Render ni sur le serveur : outils hors production. (nouveaux)
# ═════════════════════════════════════════════════════════════════════════════
# BENCH_MAX_EUR, BENCH_MODELS, BENCH_CORPUS, BENCH_CRITIC, BENCH_ESCALATION,
# BENCH_EVAL_WRITERS, BENCH_FINALISTS, BENCH_FINAL_CASES, BENCH_CASES_PER_MODEL,
# BENCH_SCREEN_CASES, BENCH_HELDOUT_TOPICS, BENCH_TOPICS, BENCH_JUDGES,
# BENCH_NO_JUDGES, BENCH_QUALITY_FLOOR, BENCH_RUN, BENCH_SHOW, BLIND_GAPS_ONLY,
# BLIND_MAX_PER, TRIAL_MAX_EUR, SONDEUR_MODELS_FILE_TEST
