DATABASE_URL="postgresql://user:pass@localhost:5432/boligo?schema=public"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3000
GROQ_API_KEY=""
# OpenRouter API Key — Orchestrateur IA principal pour les 5 Intelligences Harmonie
OPENROUTER_API_KEY=""
# Sondeur : IA par défaut (ai). Mettre "bank" pour questions fixes uniquement.
HARMONY_QUESTIONS_SOURCE=ai
# Daily.co — appels vidéo 1-to-1 (free tier)
DAILY_API_KEY=""
# true = autoriser l’appel vidéo dès la phase chat (tests). false = prod stricte.
VIDEO_TEST_UNLOCK="true"
# Tableau de bord : adresse du premier administrateur (compte BOLIGO déjà vérifié).
# N'agit que tant qu'aucun administrateur n'existe. Voir docs/PROGRAMME_PARTENAIRES.md.
ADMIN_BOOTSTRAP_EMAIL=
# Programme partenaires : adresse qui reçoit les nouvelles candidatures (défaut contact@boligo.fr)
PARTNERS_NOTIFY_EMAIL=
# Adresse publique du site, utilisée dans les liens de l'Espace partenaire (défaut https://boligo-web.onrender.com)
PUBLIC_WEB_URL=
# IA : plafond de dépense mensuel en euros, hors parcours payés (défaut 10 ; 0 coupe ces usages). Voir docs/IA_COUTS.md.
AI_MONTHLY_BUDGET_EUR=10
# Portrait des membres rédigé sans IA par défaut ; « ai » pour la rédaction par l'IA (dans le plafond).
AI_PROFILE_MODE=
# Suivi IA des parcours payés (Sondeur, lectures, bilan, relecture de sécurité de chaque réponse) : budget par parcours (défaut 3), hors plafond mensuel ; 0 coupe ce suivi ET la relecture de sécurité par l'IA (le code seul repère alors les dangers).
AI_JOURNEY_BUDGET_EUR=3
# Modèle Groq des parcours payés (vide : openai/gpt-oss-120b puis llama-3.3-70b-versatile).
GROQ_QUALITY_MODEL=
# Relecteur indépendant des questions du Sondeur (vide : llama-3.3-70b-versatile puis openai/gpt-oss-120b).
GROQ_CRITIC_MODEL=
# Plafond mensuel de tout le suivi IA des parcours payés, en euros (défaut 100 ; 0 coupe ce suivi).
AI_JOURNEY_MONTHLY_CAP_EUR=100
# OpenRouter (payant) : Claude rédige, GPT relit, pour les parcours payés. Jamais de modèle gratuit.
# Modèles (vides : choix automatique) et prix plafond en $ par million de jetons (défaut 5 / 25).
OPENROUTER_QUALITY_MODEL=
OPENROUTER_CRITIC_MODEL=
OPENROUTER_MAX_PRICE_PROMPT=
OPENROUTER_MAX_PRICE_COMPLETION=
# Vérification automatique des sociétés britanniques (clé gratuite Companies House), facultatif.
COMPANIES_HOUSE_API_KEY=

# Signalements urgents du Sondeur (détresse, mineur, menace, violence exercée) :
# adresses de l'équipe de modération prévenues tout de suite, séparées par des
# virgules. L'e-mail ne contient ni nom ni réponse.
SAFETY_ALERT_EMAILS=

# ─── Paiement et facturation (Stripe BOLIGO, jamais un autre compte) ─────────
# Voir docs/FACTURATION_TVA.md. Tout est désactivé par défaut.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Registre des paiements, factures et avoirs en base, rétractation suivie
# depuis le tableau de bord (après la migration prisma/sql/2026-10-07_facturation.sql).
BILLING_ENABLED=false
# TVA calculée par Stripe Tax (enregistrements faits dans le tableau de bord Stripe).
BILLING_STRIPE_TAX=false
BILLING_TAX_CODE=txcd_10000000
# Adresse de facturation complète demandée sur la feuille de paiement.
BILLING_ADDRESS_REQUIRED=false
# Paiement refusé sans la demande de commencement avant la fin du délai de
# rétractation (à activer dès que la nouvelle version de l'app est publiée).
BILLING_EARLY_START_CONSENT_REQUIRED=false
# Franchise en base de TVA (art. 293 B du CGI) : à confirmer avec l'expert-comptable.
BILLING_VAT_FRANCHISE=false
# Identité du vendeur sur les factures et les reçus.
BILLING_SELLER_NAME=BOLIGO
BILLING_SELLER_LEGAL_FORM=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_SIREN=
BILLING_SELLER_VAT_NUMBER=
BILLING_MEDIATOR=
# Équipe prévenue des litiges, rétractations et factures en échec (séparées par des virgules).
BILLING_ALERT_EMAILS=
