generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// 1. UTILISATEURS & PROFILS
// ---------------------------------------------------------

enum AccountStatus {
  nouveau
  en_entretien
  actif
  en_parcours
  suspendu
}

enum Gender {
  H
  F
  AUTRE
}

enum UserRole {
  USER
  ADMIN
  /// Équipe : signalements, modération, membres (sans finances ni partenaires).
  MODERATOR
  /// Équipe : programme partenaires et codes promo (sans données des membres).
  MARKETING
}

model User {
  id                 String        @id @default(uuid())
  email              String        @unique
  telephone          String?       @unique
  passwordHash       String? // Optionnel pour l'Auth sociale
  googleId           String?       @unique
  facebookId         String?       @unique
  hashedRefreshToken String?
  firstName          String
  lastName           String
  birthDate          DateTime
  gender             Gender
  city               String?
  role               UserRole      @default(USER)
  accountStatus      AccountStatus @default(nouveau)
  creditBalance      Int           @default(0)
  isVerified         Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  lastLogin          DateTime?
  pushToken          String?
  verificationCode   String?
  resetCode          String?
  resetCodeExpires   DateTime?
  termsAcceptedAt    DateTime? // Date d'acceptation expresse des CGU à l'inscription
  termsVersion       String? // Version des textes légaux acceptée (ex. « 2026-10-02 »)

  profile           Profile?
  interviews        InterviewIA[]
  mentalMaps        MentalMap[]
  receivedProposals MatchProposal[]     @relation("ReceivedProposals")
  targetedProposals MatchProposal[]     @relation("TargetedProposals")
  journeysA         Journey[]           @relation("UserA")
  journeysB         Journey[]           @relation("UserB")
  transactions      CreditTransaction[]
  sentMessages      Message[]
  sentReports       Report[]            @relation("Reporter")
  receivedReports   Report[]            @relation("Reported")
  notifications     Notification[]
  responses         HarmonyResponse[]
}

enum ProfileStatus {
  incomplet
  complet
  actif
  masque
}

model Profile {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id])
  mainPhoto       String?
  secondaryPhotos Json? // Array of URLs
  description     String?       @db.Text
  displayedCity   String?
  profession      String?
  profileStatus   ProfileStatus @default(incomplet)
}

// ---------------------------------------------------------
// 2. ENTRETIEN IA & CARTE MENTALE
// ---------------------------------------------------------

enum InterviewStatus {
  en_cours
  termine
  abandonne
}

model InterviewIA {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  startDate DateTime         @default(now())
  endDate   DateTime?
  status    InterviewStatus  @default(en_cours)
  version   Int              @default(1)
  responses ModuleResponse[]
  mentalMap MentalMap?

  @@index([userId, status])
}

model ModuleResponse {
  id           String      @id @default(uuid())
  interviewId  String
  interview    InterviewIA @relation(fields: [interviewId], references: [id])
  moduleNumber Int // 0 to 10
  moduleName   String
  rawResponses Json // The answers A, B, C, D...
  iaAnalysis   Json? // AI feedback
  moduleScore  Float?
  completedAt  DateTime    @default(now())

  @@index([interviewId])
}

model MentalMap {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  interviewId   String      @unique
  interview     InterviewIA @relation(fields: [interviewId], references: [id])
  generatedAt   DateTime    @default(now())
  synthesis     String?     @db.Text
  bio           String?     @db.Text
  needsList     Json? // Values, project, family, etc.
  redFlags      Json?
  keyValues     Json?
  maturityScore Float?
  alchemyScore  Float?
  signals       Json? // All algorithmic signals (Red, Orange, etc.)
  version       Int         @default(1)

  @@index([userId, generatedAt])
}

// ---------------------------------------------------------
// 3. MATCHING & PARCOURS
// ---------------------------------------------------------

enum ProposalStatus {
  en_attente
  acceptee
  refusee
  sauvegardee
  expiree
}

model MatchProposal {
  id                 String         @id @default(uuid())
  sourceUserId       String
  sourceUser         User           @relation("ReceivedProposals", fields: [sourceUserId], references: [id])
  targetUserId       String
  targetUser         User           @relation("TargetedProposals", fields: [targetUserId], references: [id])
  compatibilityScore Float
  iaExplanation      String?        @db.Text
  proposedAt         DateTime       @default(now())
  expiresAt          DateTime
  status             ProposalStatus @default(en_attente)
  weekNumber         Int
  journey            Journey?

  @@index([sourceUserId, status])
  @@index([targetUserId, status])
}

enum JourneyStep {
  phase_harmonie
  chat_libre
  video
  echange_contacts
  termine
}

enum JourneyResult {
  en_cours
  reussi
  echoue
  abandonne
}

model Journey {
  id             String        @id @default(uuid())
  proposalId     String        @unique
  proposal       MatchProposal @relation(fields: [proposalId], references: [id])
  userAId        String
  userA          User          @relation("UserA", fields: [userAId], references: [id])
  userBId        String
  userB          User          @relation("UserB", fields: [userBId], references: [id])
  createdAt      DateTime      @default(now())
  currentStep    JourneyStep   @default(phase_harmonie)
  stepStartDate  DateTime      @default(now())
  endDate        DateTime?
  result         JourneyResult @default(en_cours)
  closingReason  String?       @db.Text
  /// Dépense IA de ce parcours en millionièmes d'euro (plafond : AI_JOURNEY_BUDGET_EUR, 1 € par défaut).
  aiCostMicroEur Int           @default(0)

  harmonyQuestions   HarmonyQuestion[]
  insights           JourneyInsight[]
  messages           Message[]
  videoSession       VideoSession?
  contactExchange    ContactExchange?
  creditTransactions CreditTransaction[]
  alumniCouple       AlumniCouple?

  @@index([userAId])
  @@index([userBId])
}

// ---------------------------------------------------------
// 4. PHASE HARMONIE (3 JOURS)
// ---------------------------------------------------------

model HarmonyQuestion {
  id           String            @id @default(uuid())
  journeyId    String
  journey      Journey           @relation(fields: [journeyId], references: [id])
  day          Int // 1, 2, 3
  theme        String
  emoji        String?
  questionText String            @db.Text
  options      Json? // QCM options (dont "Autre...")
  sentAt       DateTime          @default(now())
  /// Question d'approfondissement écrite par l'IA après la lecture de la journée précédente.
  followUp     Boolean           @default(false)
  responses    HarmonyResponse[]

  @@index([journeyId])
}

/// Lecture du Sondeur : une par journée terminée par les deux membres (day 1 à 3)
/// et le bilan Harmonie (day 0). Rédigée par l'IA pour un parcours payé,
/// sinon par les règles de BOLIGO. Effacée avec le parcours.
model JourneyInsight {
  id        String   @id @default(uuid())
  journeyId String
  journey   Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  day       Int
  /// 'ia' ou 'regles'
  source    String
  content   Json
  createdAt DateTime @default(now())

  @@unique([journeyId, day])
}

model HarmonyResponse {
  id           String          @id @default(uuid())
  questionId   String
  question     HarmonyQuestion @relation(fields: [questionId], references: [id])
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  responseText String          @db.Text
  respondedAt  DateTime        @default(now())
  delayHours   Float?

  @@index([questionId])
  @@index([userId])
}

// ---------------------------------------------------------
// 5. COMMUNICATION & MODÉRATION
// ---------------------------------------------------------

enum MessageType {
  texte
  emoji
  vocal
}

enum ModerationStatus {
  ok
  en_verification
  bloque
}

model Message {
  id               String           @id @default(uuid())
  journeyId        String
  journey          Journey          @relation(fields: [journeyId], references: [id])
  senderId         String
  sender           User             @relation(fields: [senderId], references: [id])
  content          String           @db.Text
  type             MessageType      @default(texte)
  sentAt           DateTime         @default(now())
  isRead           Boolean          @default(false)
  moderationStatus ModerationStatus @default(ok)
  report           Report?

  @@index([journeyId, sentAt])
  @@index([senderId])
}

enum ReportReason {
  insulte
  harcelement
  faux_profil
  spam
  autre
}

enum ReportStatus {
  en_attente
  traite
  rejete
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedId  String
  reported    User         @relation("Reported", fields: [reportedId], references: [id])
  messageId   String?      @unique
  message     Message?     @relation(fields: [messageId], references: [id])
  reason      ReportReason
  description String?      @db.Text
  reportedAt  DateTime     @default(now())
  status      ReportStatus @default(en_attente)

  @@index([reporterId])
  @@index([reportedId])
}

// ---------------------------------------------------------
// 6. CRÉDITS & PAIEMENT
// ---------------------------------------------------------

enum TransactionType {
  achat
  consommation
  remboursement_justice
}

model CreditTransaction {
  id           String          @id @default(uuid())
  /// Vide après suppression du compte : le paiement est gardé anonymisé (obligation comptable).
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  journeyId    String?
  journey      Journey?        @relation(fields: [journeyId], references: [id])
  promoCodeId  String?
  promoCode    PromoCode?      @relation(fields: [promoCodeId], references: [id])
  type         TransactionType
  creditAmount Int
  euroAmount   Float?
  paymentRef   String?
  date         DateTime        @default(now())
  description  String?

  @@index([userId])
  @@index([journeyId])
  @@index([paymentRef])
  /// Ventes par code promo (partenaires, page Codes promo, Espace partenaire).
  @@index([promoCodeId])
}

// ---------------------------------------------------------
// 6b. CODES PROMO
// ---------------------------------------------------------

enum DiscountType {
  percent // % de réduction (discountValue = %)
  fixed // Réduction fixe (discountValue = centimes)
  free // Gratuit (discountValue ignoré)
}

model PromoCode {
  id            String              @id @default(uuid())
  code          String              @unique
  discountType  DiscountType
  discountValue Int                 @default(0) // 50 = 50%, 500 = 5€, ou 0 si free
  maxUses       Int? // null = illimité
  usedCount     Int                 @default(0)
  expiresAt     DateTime? // null = pas d'expiration
  isActive      Boolean             @default(true)
  description   String?
  createdAt     DateTime            @default(now())
  usages        PromoUsage[]
  transactions  CreditTransaction[]
  partner       PartnerApplication?
}

model PromoUsage {
  id          String    @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  userId      String
  usedAt      DateTime  @default(now())

  @@unique([promoCodeId, userId]) // Un user = un seul usage par code
  @@index([userId])
}

// ---------------------------------------------------------
// 7. VIDÉO & CONTACTS
// ---------------------------------------------------------

enum VideoStatus {
  planifiee
  en_cours
  terminee
  annulee
}

model VideoSession {
  id              String      @id @default(uuid())
  journeyId       String      @unique
  journey         Journey     @relation(fields: [journeyId], references: [id])
  plannedDate     DateTime?
  startDate       DateTime?
  endDate         DateTime?
  durationMinutes Int?
  status          VideoStatus @default(planifiee)
  consentA        Boolean     @default(false)
  consentB        Boolean     @default(false)
  dailyRoomName   String?
  dailyRoomUrl    String?
}

model ContactExchange {
  id          String    @id @default(uuid())
  journeyId   String    @unique
  journey     Journey   @relation(fields: [journeyId], references: [id])
  consentA    Boolean   @default(false)
  consentB    Boolean   @default(false)
  phoneShared Boolean   @default(false)
  emailShared Boolean   @default(false)
  exchangedAt DateTime?
}

// ---------------------------------------------------------
// 8. SUIVI & SYSTÈME
// ---------------------------------------------------------

model AlumniCouple {
  id          String   @id @default(uuid())
  journeyId   String   @unique
  journey     Journey  @relation(fields: [journeyId], references: [id])
  validatedAt DateTime @default(now())
  testimony   String?  @db.Text
  status      String   @default("actif") // e.g., actif, archive
}

enum NotificationType {
  nouveau_match
  message
  question_harmonie
  rappel_reponse
  credit
  systeme
}

model Notification {
  id      String           @id @default(uuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id])
  type    NotificationType
  title   String
  content String           @db.Text
  sentAt  DateTime         @default(now())
  isRead  Boolean          @default(false)

  @@index([userId, isRead])
}

// ---------------------------------------------------------
// 9. RECRUTEMENT & OFFRES D'EMPLOI
// ---------------------------------------------------------

model JobOffer {
  id           String           @id @default(uuid())
  title        String
  description  String           @db.Text
  requirements String           @db.Text
  location     String // Ex: Paris, Abidjan, Télétravail
  type         String // Ex: CDI, CDD, Stage, Alternance, Freelance
  department   String? // Ex: Tech, Operations, Marketing
  salary       String? // Ex: 40k-50k
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  applications JobApplication[]
}

model JobApplication {
  id          String   @id @default(uuid())
  jobId       String
  job         JobOffer @relation(fields: [jobId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String
  telephone   String?
  coverLetter String?  @db.Text
  cvUrl       String? // Chemin local ou URL externe du CV
  cvFilename  String? // Nom d'origine du fichier CV
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------
// PROGRAMME PARTENAIRES (marques, ambassadeurs, créateurs)
// ---------------------------------------------------------

enum PartnerType {
  /// Marque ou annonceur : visibilité auprès de la communauté BOLIGO.
  ANNONCEUR
  /// Ambassadeur commercial : recommande BOLIGO dans sa ville ou son réseau.
  AMBASSADEUR
  /// Créateur de contenu ou influenceur.
  CREATEUR
}

/// Type de numéro d'entreprise fourni par le partenaire.
enum PartnerRegistrationType {
  /// France : SIREN (9 chiffres) ou SIRET (14 chiffres)
  SIRENE
  /// Union européenne : numéro de TVA intracommunautaire
  TVA_UE
  /// Royaume-Uni : company number (Companies House)
  UK_COMPANY
  /// Autre pays : numéro officiel d'immatriculation
  AUTRE
}

enum PartnerVerification {
  A_VERIFIER
  VERIFIE
  REJETE
}

enum PartnerStatus {
  NOUVEAU
  EN_COURS
  ACCEPTE
  REFUSE
}

model PartnerApplication {
  id                 String                   @id @default(uuid())
  type               PartnerType
  status             PartnerStatus            @default(NOUVEAU)
  name               String
  email              String
  company            String?
  country            String
  city               String?
  website            String?
  /// Réseaux et taille d'audience (créateurs), zone couverte (ambassadeurs), budget (marques).
  audience           String?
  message            String
  language           String                   @default("fr")
  /// Notes internes de l'équipe (jamais montrées au candidat).
  notes              String?
  /// Commission en % sur chaque Parcours payé avec son code (ambassadeurs, créateurs).
  commissionRate     Int?
  promoCodeId        String?                  @unique
  promoCode          PromoCode?               @relation(fields: [promoCodeId], references: [id])
  /// Immatriculation de l'entreprise du partenaire (obligatoire pour travailler avec BOLIGO).
  registrationType   PartnerRegistrationType?
  registrationNumber String?
  /// Contrôle auprès des registres publics (INSEE, VIES, Companies House) ou contrôle manuel.
  verificationStatus PartnerVerification      @default(A_VERIFIER)
  verificationMethod String?
  /// Nom officiel renvoyé par le registre, à comparer au nom déclaré.
  verifiedName       String?
  verificationNote   String?
  verifiedAt         DateTime?
  /// Adresse e-mail de l'administrateur, pour un contrôle manuel.
  verifiedBy         String?
  /// Espace partenaire : empreinte SHA-256 du lien privé (le lien n'est jamais stocké).
  portalTokenHash    String?                  @unique
  /// Date d'envoi du dernier lien vers l'Espace partenaire.
  portalLinkSentAt   DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([type, status])
  @@index([email])
}

/// Dépense IA du mois : garde-fou budgétaire (AI_MONTHLY_BUDGET_EUR), en millionièmes d'euro.
model AiSpend {
  month               String   @id
  calls               Int      @default(0)
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  costMicroEur        Int      @default(0)
  /// Suivi IA des parcours payés : budget propre à chaque parcours, hors plafond mensuel.
  journeyCalls        Int      @default(0)
  journeyCostMicroEur BigInt   @default(0)
  updatedAt           DateTime @updatedAt
}
